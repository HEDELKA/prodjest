{
  "manifest_version": 3,
  "name": "DSH Browser Bridge",
  "version": "0.2.0",
  "description": "Локальный мост: позволяет агенту DeepSeek Harness управлять этим браузером Chrome через chrome.debugger (соединение только с 127.0.0.1, по токену).",
  "permissions": ["debugger", "tabs", "storage", "tabGroups"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DSH Browser Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
